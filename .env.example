# Template. Copy to .env and fill in real values.
# .env is gitignored — this file is safe to commit.

# Google Gemini API key — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Overrides the model in src/generate.js. Useful when the default is
# having a bad day: on Sept 2 2026 gemini-3.7-flash timed out on every request
# while gemini-3.5-flash answered normally.
GEMINI_MODEL=

# Optional. Per-request ceiling in ms (default 60000). Three attempts are made,
# so the worst case a caller waits is roughly three times this.
GEMINI_TIMEOUT_MS=

# Supabase (hosted free-tier project). URL + ANON are public-by-design and go to
# the browser; SERVICE_ROLE is secret and server-only (bypasses RLS). Leave blank
# to run Storyloom without accounts — it degrades to the single-user flow.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
