{
  "name": "storyloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Storyloom — turn text or a URL into an on-brand, editable carousel",
  "scripts": {
    "postinstall": "puppeteer browsers install chrome",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:degraded": "node scripts/dev-degraded.mjs",
    "render": "node src/render.js",
    "validate": "node src/validate.js",
    "generate": "node src/generate.js",
    "extract": "node src/extract.js",
    "test": "node --test",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "render:all": "node src/render.js fixtures/sample-5.json && node src/render.js fixtures/sample-10.json && node src/render.js fixtures/sample-ugly.json"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.114.0",
    "ajv": "^8.17.1",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "puppeteer": "24.36.0"
  }
}
